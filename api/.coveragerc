[run]
branch = True
# Scoped to the demo's control-domain modules (transactions, debit_cards + logging layer).
source = .
omit =
    accounts/*
    api/*
    notifications/*
    users/*
    websocket/*
    virtual_bank/*.py
    conftest.py
    manage.py
    */migrations/*
    */tests/*
    */admin.py
    */apps.py

[report]
show_missing = True
precision = 1

[html]
directory = reports/coverage_html

[xml]
output = reports/coverage.xml
